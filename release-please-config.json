{
  "release-type": "rust",
  "initial-version": "0.0.1",
  "force-tag-creation": true,
  "always-update": true,
  "changelog-type": "github",
  "version-file": "version.txt",
  "bootstrap-sha": "1a849e40",
  "exclude-paths": ["./packages/rust/conundrum_logic"],
  "plugins": [
    {
      "type": "cargo-workspace",
      "updateAllPackages": true,
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "conundrum",
      "components": [
        "conundrum",
        "conundrum_cli",
        "conundrum_config",
        "conundrum_db",
        "conundrum_fs",
        "conundrum_macro_traits",
        "conundrum_macros",
        "conundrum_swift",
        "conundrum_server_rs",
        "conundrum_tools",
        "conundrum_wasm",
        "fluster_core_utilities"
      ]
    }
  ],
  "packages": {
    "packages/rust/conundrum": {
      "changelog-path": "packages/rust/conundrum",
      "component": "conundrum"
    },
    "packages/rust/conundrum_cli": {
